# Local PostGIS from docker-compose.yml. For Neon, paste the branch connection string instead.
DATABASE_URL=postgres://mdu:mdu@localhost:54329/mdu

# Integration tests create and drop a throwaway database through this connection (needs CREATEDB).
TEST_DATABASE_URL=postgres://mdu:mdu@localhost:54329/postgres

# Cloudflare R2 (S3 API). Needed locally only for `mdu fixtures push/pull`. Same values as the
# GitHub Actions secrets; the endpoint is the bucket's S3 API URL as Cloudflare shows it, ending in
# the bucket name (…eu.r2.cloudflarestorage.com/<bucket>). The stored objects sit under that
# extra folder, so an endpoint without it finds nothing (Vercel's read-only token too, ADR 0019).
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Classifier LLM fallback (ADR 0008): Claude Haiku for documents no rule recognises. Unset = rules
# only. Same value as the ANTHROPIC_API_KEY GitHub Actions secret. Monthly spend cap in USD.
ANTHROPIC_API_KEY=
MDU_LLM_MONTHLY_USD=5

# Admin login (ADR 0012). A GitHub OAuth App's client ID and secret, a random AUTH_SECRET
# (`openssl rand -base64 33`), and the GitHub usernames allowed in, comma-separated. Without
# them /admin says it isn't configured. Set the same names in the Vercel project.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_GITHUB_LOGINS=

# Watchdog (M5.4, ADR 0021), Vercel only: Vercel Cron sends CRON_SECRET (random,
# `openssl rand -hex 32`) to /api/watchdog, which opens GitHub alert issues with
# GITHUB_ALERT_TOKEN (fine-grained, this repository only, Issues: read and write).
CRON_SECRET=
GITHUB_ALERT_TOKEN=
